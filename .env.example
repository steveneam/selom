# Selom — environment variable template.
#
# NONE of these are provisioned yet. The owner chose placeholders intentionally
# (build-for-self first; provision real services before launch). Copy this file
# to `.env` (gitignored) and fill in real values when each service is wired.
# Replace every TODO_* below with a real secret — never commit the filled .env.

# ── Supabase (auth + Postgres + RLS) ────────────────────
SUPABASE_URL=TODO_https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=TODO_anon_key
SUPABASE_SERVICE_ROLE_KEY=TODO_service_role_key
DATABASE_URL=TODO_postgresql://user:pass@host:5432/postgres

# ── Cloudflare R2 (object storage: uploads + figure exports) ─
R2_ACCOUNT_ID=TODO_account_id
R2_ACCESS_KEY_ID=TODO_access_key_id
R2_SECRET_ACCESS_KEY=TODO_secret_access_key
R2_BUCKET=TODO_bucket_name

# ── Job queue (B3) ──────────────────────────────────────
# inline (default — run on-request, no infra) | arq (Redis worker). Leave unset for inline.
SELOM_QUEUE=inline

# ── Redis (arq async job queue + cache) ─────────────────
# Only needed when SELOM_QUEUE=arq. Run the worker: `uv run --directory app/backend arq jobs.worker.WorkerSettings`.
REDIS_URL=TODO_redis://localhost:6379/0

# ── Stripe (billing — see LAUNCH-GATES.md re: merchant-of-record) ─
STRIPE_SECRET_KEY=TODO_sk_test_xxx

# ── AI gateway (LLM navigator routing) ──────────────────
AI_GATEWAY_URL=TODO_https://gateway.example.com

# ── Frontend → backend base URL (local dev default) ─────
NEXT_PUBLIC_API_BASE=http://localhost:8000
