# Selom — environment variable template.
#
# NONE of these are provisioned yet. The owner chose placeholders intentionally
# (build-for-self first; provision real services before launch). Copy this file
# to `.env` (gitignored) and fill in real values when each service is wired.
# Replace every TODO_* below with a real secret — never commit the filled .env.

# ── Supabase (auth + Postgres + RLS) ────────────────────
SUPABASE_URL=TODO_https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=TODO_anon_key
SUPABASE_SERVICE_ROLE_KEY=TODO_service_role_key
DATABASE_URL=TODO_postgresql://user:pass@host:5432/postgres

# ── Object store (result bundles · cache · artifacts · ledger) ─
# local (default — filesystem under app/backend/data, no AWS) | s3 (regional AWS S3).
# AWS creds come from the standard chain (~/.aws/credentials in dev, the Lambda role
# in prod), NOT from Selom env vars. See docs/aws-materialization/spec.md §1.
SELOM_OBJECT_STORE=local
SELOM_S3_BUCKET=TODO_bucket_name
SELOM_S3_REGION=ap-southeast-2

# ── Job store (statelessness — AWS materialization step 2) ─
# memory (default — in-process JobStore, inline dev, zero infra) | sql (analysis_jobs table,
# so a poll on one instance sees a job created on another). dev/test = SQLite, prod = Aurora
# Postgres. psycopg is the prod driver: `uv pip install 'psycopg[binary]'`. SELOM_DB_AUTO_CREATE
# auto-builds the schema from code (dev/SQLite only) — prod runs `alembic upgrade head` instead.
SELOM_JOB_STORE=memory
SELOM_DATABASE_URL=TODO_postgresql+psycopg://user:pass@host:5432/selom
SELOM_DB_AUTO_CREATE=false

# ── Job queue (B3) ──────────────────────────────────────
# inline (default — run on-request, no infra) | arq (Redis worker). Leave unset for inline.
SELOM_QUEUE=inline

# ── Redis (arq async job queue + cache) ─────────────────
# Only needed when SELOM_QUEUE=arq. Run the worker: `uv run --directory app/backend arq jobs.worker.WorkerSettings`.
REDIS_URL=TODO_redis://localhost:6379/0

# ── Stripe (billing — see LAUNCH-GATES.md re: merchant-of-record) ─
STRIPE_SECRET_KEY=TODO_sk_test_xxx

# ── AI gateway (LLM navigator routing) ──────────────────
AI_GATEWAY_URL=TODO_https://gateway.example.com

# ── Frontend → backend base URL (local dev default) ─────
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── Cloud import: Nango OAuth broker + per-provider flags ─
# THIS FILE'S real twin (<repo root>/.env) is what app/backend/config.py loads — NOT
# app/backend/.env, which stages the raw OAuth client ids/secrets for pasting into Nango's own
# dashboard and is never read by Selom. Keep each setting in exactly one home
# (app/backend/tests/test_cloud_env_home.py enforces it).
#
# TWO NANGO INSTANCES EXIST. Live = https://nango.swordfish.cfd (self-hosted on syd2); a local
# dev stack on 127.0.0.1:3003 shares nothing with it and a secret key from one returns
# `unknown_account` on the other. Verify with `bash deploy/nango/preflight.sh` (exit-code gated)
# before asking anyone to complete an OAuth consent.
SELOM_NANGO_BASE_URL=TODO_https://nango.example.com
SELOM_NANGO_SECRET_KEY=TODO_nango_secret_key
# Per-provider server-side gate on the OAuth import path. Unset ⇒ GET /cloud/providers reports
# enabled=false and /uploads/intake/remote refuses the provider. OneDrive is on hold (OH-10).
SELOM_CLOUD_GOOGLE=false
SELOM_CLOUD_DROPBOX=false
SELOM_CLOUD_ONEDRIVE=false
