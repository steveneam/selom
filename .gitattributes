# Line-ending normalization (eng-practices port, M-001).
# LF in the repo so a CRLF working-tree line cannot smuggle a merge-conflict marker past a
# carriage-return-naive matcher. Scripts/hooks stay LF because they run via sh (incl. Linux CI).

* text=auto

*.sh    text eol=lf
*.mjs   text eol=lf
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
.githooks/* text eol=lf

# Binary assets: never normalize.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.h5ad    binary
*.mzML    binary
*.db      binary
*.parquet binary
