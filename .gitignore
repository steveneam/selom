# ── Python ──────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# ── Node ────────────────────────────────────────────────
node_modules/
**/node_modules/
.next/
out/
dist/
build/
coverage/
.turbo/

# ── Env (keep the example) ──────────────────────────────
.env
.env.*
!.env.example

# ── OS cruft ────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs / temp ─────────────────────────────────────────
*.log
.tmp/
.scratch/

# Pre-edit backups left by tooling (e.g. .mcp.json.bak). Never a source of truth —
# they are strict subsets of the file they shadow. Delete them, don't commit them.
*.bak

# Local dev SQLite, created by `SELOM_DATABASE_URL=sqlite:///dev.db` (alembic env.py,
# test_engine_policy_guard). Regenerated on demand; never a source of truth.
app/backend/dev.db

# ── Omics data (never commit large/PHI-adjacent payloads) ─
*.h5ad
*.mzML
app/backend/data/
data/

# Built GO gene-set library + DAG (~5-7MB, regenerate: scripts/build_gene_sets.py).
# enrichment falls back to the committed gene_sets.json sample when absent;
# go_graph falls back to its run.py stub when go_dag.json is absent.
app/backend/skills/enrichment/gene_sets_go.json
app/backend/skills/go_graph/go_dag.json

# Large derived NCBI-gene_info maps (regenerate: scripts/build_symbols.py /
# scripts/build_ensembl_map.py). gene_sets/normalize.py + skills/_genes.py degrade
# gracefully when absent. The WikiPathways + curated corpus (gene_sets/corpus/*.json)
# IS committed — only these large derived maps are ignored.
app/backend/gene_sets/corpus/hgnc_symbols.json
app/backend/gene_sets/corpus/ensembl_symbols.json

# ── Assistant-local (tracked .claude/ otherwise) ────────
# Internal dev-ops AWS access checklist — kept local, not part of the product repo.
docs/aws-materialization/aws-access-setup.md
.claude/settings.local.json
.claude/scheduled_tasks.lock
# impeccable — 3rd-party design skill, vendored locally; reinstall with
# `npx impeccable skills install --providers=claude` (do not commit the tool).
.claude/skills/impeccable/

# ── Parallel-agent worktrees (git-worktree lanes; never committed) ──
# `claude --worktree <lane>` creates .claude/worktrees/<lane>/ per lane.
# Protocol lives in the research vault (Forj/bones/parallel-agents.md); the
# repo-side board + boot checklist is COORDINATION.md.
.claude/worktrees/

# ── Cross-agent coordination working-copies + migration artifacts (kept LOCAL) ──
# The swordfish channel files are read by watchers from disk, not git; Selom's "no migration detail /
# box topology in a tracked file" rule keeps them out of history. (Peers track the channel files; swap
# these to tracked only on an explicit call.) The drive-ark / resume-prompt / drive-notes are one-off
# migration artifacts that must never enter git.
agent_handoff/FROM-SWORDFISH.md
agent_handoff/FROM-SWORDFISH-DRIVE-ARK.md
agent_handoff/ASK-BACKS-FOR-SWORDFISH.md
agent_handoff/RESUME-PROMPT-2026-07-13.txt
agent_handoff/drive-notes/

# ── Graphify outputs (regenerable — never versioned) ─────────────────────────────────────────────
# Ignore the whole tree: dated snapshots accumulate and every artifact is regenerable output, so
# none of it needs versioning. (Also why `git add -A` is banned here — it would otherwise sweep
# ~17 MB in.) Graphify's wiring role is retired (M-007); wiring integrity is held by the executable
# ratchets (scripts/guards/ + the *.guard.test.* suites), not by this graph.
graphify-out/
