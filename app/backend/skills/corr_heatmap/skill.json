{
  "id": "corr_heatmap",
  "version": "0.1.0",
  "title": "Correlation heatmap",
  "engine": "python",
  "omics": "bulk-rna-seq|scrna-seq|proteomics",
  "entrypoint": "skills.corr_heatmap.run:run",
  "inputs": [{ "name": "matrix", "kind": "csv|tsv|xlsx", "required": true }],
  "param_spec": {
    "axis":    { "type": "str",  "default": "samples", "options": ["samples", "features"] },
    "method":  { "type": "str",  "default": "pearson", "options": ["pearson", "spearman"] },
    "cluster": { "type": "bool", "default": true }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" }
  ],
  "catalog": {
    "summary": "Hierarchically-clustered sample×sample (or feature×feature) correlation matrix — replicate concordance & batch structure at a glance.",
    "category": "data-visualization",
    "tier": "verified",
    "status": "production",
    "input_formats": [".csv", ".tsv", ".xlsx"],
    "chains_with": ["pca", "heatmap"],
    "license": "MIT",
    "popularity": 68
  }
}
