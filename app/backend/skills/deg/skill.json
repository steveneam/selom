{
  "id": "deg",
  "version": "0.1.0",
  "title": "Differential expression",
  "engine": "python",
  "omics": "scrna-seq|bulk-rna-seq",
  "entrypoint": "skills.deg.run:run",
  "inputs": [{ "name": "matrix", "kind": "anndata|h5ad|csv", "required": true }],
  "param_spec": {
    "mode":      { "type": "str", "default": "auto" },
    "groupby":   { "type": "str", "default": "leiden" },
    "method":    { "type": "str", "default": "wilcoxon" },
    "top_n":     { "type": "int", "default": 15, "min": 5, "max": 50 },
    "normalize": { "type": "bool", "default": true },
    "reference": { "type": "str", "default": "" },
    "treatment": { "type": "str", "default": "" },
    "group_col": { "type": "str", "default": "" },
    "group_val": { "type": "str", "default": "" },
    "time_col":  { "type": "str", "default": "time" },
    "covariate_col": { "type": "str", "default": "" },
    "min_count": { "type": "int", "default": 10, "min": 0, "max": 1000 },
    "normalization": { "type": "str", "default": "deseq2", "options": ["deseq2", "tmm"] },
    "sample_col":    { "type": "str", "default": "", "note": "pseudobulk: obs column = biological replicate id" },
    "condition_col": { "type": "str", "default": "", "note": "pseudobulk: obs column = condition to contrast" },
    "label_col":     { "type": "str", "default": "", "note": "pseudobulk: optional obs column = cell-type/cluster" },
    "label":         { "type": "str", "default": "", "note": "pseudobulk: restrict to this label_col value" },
    "min_cells":     { "type": "int", "default": 10, "min": 0, "max": 1000, "note": "pseudobulk: drop samples with fewer cells" }
  },
  "inputs_optional": [
    { "name": "design", "kind": "csv", "required": false, "note": "sample id + condition/time columns; bulk + time-course" }
  ],
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" },
    { "name": "table",  "kind": "csv" }
  ],
  "catalog": {
    "summary": "Bulk / pseudo-bulk DE (pyDESeq2) or marker ranking (Wilcoxon) per contrast.",
    "category": "differential-expression",
    "tier": "verified",
    "status": "production",
    "input_formats": [".h5ad", ".csv"],
    "chains_with": ["volcano", "enrichment"],
    "license": "MIT",
    "popularity": 90
  }
}
