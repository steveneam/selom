{
  "id": "enrichment",
  "version": "0.1.0",
  "title": "Pathway enrichment",
  "engine": "python",
  "omics": "bulk-rna-seq|scrna-seq|proteomics",
  "entrypoint": "skills.enrichment.run:run",
  "inputs": [{ "name": "matrix", "kind": "csv", "required": true }],
  "param_spec": {
    "top_n":         { "type": "int",   "default": 12,   "min": 3, "max": 40 },
    "gene_sets":     { "type": "str",   "default": "go", "options": ["go", "wikipathways", "curated", "all"] },
    "direction":     { "type": "str",   "default": "combined", "options": ["combined", "split"] },
    "fdr_threshold": { "type": "float", "default": 0.05, "min": 0.0, "max": 1.0 },
    "fc_threshold":  { "type": "float", "default": 0.0,  "min": 0.0, "max": 5.0 }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" },
    { "name": "table",  "kind": "csv" }
  ],
  "catalog": {
    "summary": "In-house hypergeometric ORA + BH-FDR over GO & Reactome; dotplot output.",
    "category": "pathway-analysis",
    "tier": "verified",
    "status": "beta",
    "input_formats": [".csv"],
    "chains_with": ["deg", "volcano"],
    "license": "MIT",
    "popularity": 72
  }
}
