{
  "id": "heatmap",
  "version": "0.1.0",
  "title": "Expression heatmap",
  "engine": "python",
  "omics": "scrna-seq|bulk-rna-seq",
  "omics_type": ["general"],
  "entrypoint": "skills.heatmap.run:run",
  "inputs": [{ "name": "matrix", "kind": "anndata|h5ad|csv", "required": true }],
  "param_spec": {
    "n_genes":    { "type": "int", "default": 20, "min": 5, "max": 100 },
    "groupby":    { "type": "str", "default": "leiden" },
    "dendrogram": { "type": "str", "default": "none", "options": ["none", "row"] }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" }
  ],
  "catalog": {
    "summary": "Clustered heatmap of marker / top-variable genes, row z-scored.",
    "category": "data-visualization",
    "tier": "verified",
    "status": "production",
    "input_formats": [".h5ad", ".csv"],
    "chains_with": ["deg"],
    "license": "MIT",
    "popularity": 76
  }
}
