{
  "id": "line",
  "version": "0.1.0",
  "title": "Line plot",
  "engine": "python",
  "omics": "bulk-rna-seq|scrna-seq|proteomics|metabolomics",
  "omics_type": ["general"],
  "entrypoint": "skills.line.run:run",
  "inputs": [{ "name": "table", "kind": "csv|tsv|xlsx", "required": true }],
  "param_spec": {
    "x":       { "type": "str",  "default": "", "note": "X column. Blank = first numeric column." },
    "y":       { "type": "str",  "default": "", "note": "Y column. Blank = second numeric column." },
    "series":  { "type": "str",  "default": "", "note": "Draw one line per value of this column. Never auto-detected — guessing it would silently change what the figure means." },
    "error":   { "type": "str",  "default": "sem", "options": ["sem", "sd", "ci95", "minmax"] },
    "spread":  { "type": "str",  "default": "band", "options": ["band", "error_bars", "individual", "both", "none"] },
    "central": { "type": "str",  "default": "mean", "options": ["mean", "representative", "none"] },
    "markers": { "type": "bool", "default": false, "note": "Mark each measured x." },
    "points":  { "type": "bool", "default": false, "note": "Show every individual replicate value." },
    "log_x":   { "type": "bool", "default": false, "note": "Log x-axis — for dose/intensity ladders." }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" }
  ],
  "catalog": {
    "summary": "Line plot of one or more series over a continuous x — time course, dose response, intensity ladder — with the mean per point and its spread as a shaded band, error bars or the individual replicate curves. Repeated rows at the same x are treated as replicates, so a plain long-form table needs no reshaping.",
    "category": "data-visualization",
    "tier": "verified",
    "status": "production",
    "input_formats": [".csv", ".tsv", ".xlsx"],
    "chains_with": ["regression", "boxplot", "normalization_qc"],
    "license": "MIT",
    "popularity": 81
  }
}
