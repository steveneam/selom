{
  "id": "proteomics_de",
  "version": "0.1.0",
  "title": "Proteomics differential abundance",
  "engine": "python",
  "omics": "proteomics",
  "omics_type": ["proteomics"],
  "entrypoint": "skills.proteomics_de.run:run",
  "inputs": [{ "name": "matrix", "kind": "csv", "required": true }],
  "param_spec": {
    "group_a":       { "type": "str",   "default": "" },
    "group_b":       { "type": "str",   "default": "" },
    "fc_threshold":  { "type": "float", "default": 1.0,  "min": 0.0, "max": 5.0 },
    "fdr_threshold": { "type": "float", "default": 0.05, "min": 0.0, "max": 1.0 },
    "top_n":         { "type": "int",   "default": 10,   "min": 0,   "max": 50 },
    "min_valid":     { "type": "float", "default": 0.5,  "min": 0.0, "max": 1.0 },
    "log_input":     { "type": "bool",  "default": false },
    "stats":         { "type": "str",   "default": "welch", "options": ["welch", "moderated"] }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" }
  ],
  "catalog": {
    "summary": "Differential abundance from a proteomics intensity matrix (log2 + median-normalize + Welch or limma-style moderated t-test, BH-FDR) drawn as a volcano.",
    "category": "proteomics",
    "tier": "verified",
    "status": "beta",
    "input_formats": [".csv"],
    "chains_with": ["enrichment", "heatmap"],
    "license": "MIT",
    "popularity": 60
  }
}
