{
  "id": "pvca",
  "version": "0.1.0",
  "title": "Principal variance components (batch effect)",
  "engine": "python",
  "omics": "scrna-seq|bulk-rna-seq|proteomics|metabolomics",
  "entrypoint": "skills.pvca.run:run",
  "inputs": [{ "name": "matrix", "kind": "csv", "required": true }],
  "param_spec": {
    "factors":       { "type": "str",   "default": "" },
    "pct_threshold": { "type": "float", "default": 0.6, "min": 0.1, "max": 1.0 },
    "normalize":     { "type": "bool",  "default": true }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" }
  ],
  "catalog": {
    "name": "Selom PVCA",
    "summary": "Principal Variance Component Analysis — apportions total expression variance across known sample factors (batch, cell type, dataset) to quantify batch effect before/after integration. Per-PC ANOVA variance components weighted by eigenvalue.",
    "category": "quality-control",
    "tier": "verified",
    "status": "beta",
    "input_formats": [".csv"],
    "chains_with": ["normalization_qc", "pca", "corr_heatmap"],
    "license": "MIT",
    "popularity": 52
  }
}
