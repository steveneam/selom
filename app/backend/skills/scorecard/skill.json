{
  "id": "scorecard",
  "version": "0.1.0",
  "title": "Benchmark scorecard (radar)",
  "engine": "python",
  "omics": "bulk-rna-seq|scrna-seq|proteomics",
  "entrypoint": "skills.scorecard.run:run",
  "inputs": [{ "name": "matrix", "kind": "csv|tsv|xlsx", "required": true }],
  "param_spec": {
    "layout":    { "type": "str",  "default": "radar", "options": ["radar", "heatmap"] },
    "normalize": { "type": "bool", "default": true },
    "fill":      { "type": "bool", "default": true },
    "max_rows":  { "type": "int",  "default": 8, "min": 1, "max": 20 }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" }
  ],
  "catalog": {
    "summary": "Scorecard comparing conditions across many metrics — rank N models/protocols on M scores at a glance (per-metric min–max normalized). Radar (spider) or metrics×conditions heatmap layout. Paper Figs 6F/S6C.",
    "category": "data-visualization",
    "tier": "verified",
    "status": "production",
    "input_formats": [".csv", ".tsv", ".xlsx"],
    "chains_with": ["corr_heatmap", "composition"],
    "license": "MIT",
    "popularity": 60
  }
}
