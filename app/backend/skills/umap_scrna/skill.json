{
  "id": "umap_scrna",
  "version": "0.1.0",
  "title": "scRNA UMAP",
  "engine": "python",
  "omics": "scrna-seq",
  "entrypoint": "skills.umap_scrna.run:run",
  "inputs": [{ "name": "matrix", "kind": "anndata|10x_mtx|h5ad", "required": true }],
  "param_spec": {
    "n_neighbors": { "type": "int", "default": 15, "min": 2, "max": 100 },
    "n_pcs":       { "type": "int", "default": 50, "min": 2, "max": 200 },
    "n_hvg":       { "type": "int", "default": 0, "min": 0, "max": 10000, "note": "select top-N highly variable genes before PCA (0 = all genes; ~2000 recommended)" },
    "color_by":    { "type": "str", "default": "leiden" },
    "normalize":   { "type": "bool", "default": true },
    "embedding":   { "type": "str", "default": "" }
  },
  "outputs": [{ "name": "figure", "kind": "plotly_spec" }],
  "catalog": {
    "summary": "QC → normalize → PCA → neighbors → UMAP, coloured by Leiden cluster.",
    "category": "single-cell",
    "tier": "verified",
    "status": "production",
    "input_formats": [".h5ad", ".csv"],
    "chains_with": ["deg", "heatmap"],
    "license": "MIT",
    "popularity": 98
  }
}
