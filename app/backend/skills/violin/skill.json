{
  "id": "violin",
  "version": "0.1.0",
  "title": "Marker-gene violins",
  "engine": "python",
  "omics": "scrna-seq",
  "entrypoint": "skills.violin.run:run",
  "inputs": [{ "name": "matrix", "kind": "anndata|h5ad", "required": true }],
  "param_spec": {
    "gene":       { "type": "str",   "default": "" },
    "groupby":    { "type": "str",   "default": "leiden" },
    "resolution": { "type": "float", "default": 1.0, "min": 0.1, "max": 4.0 },
    "normalize":  { "type": "bool",  "default": true },
    "annotate":   { "type": "str",   "default": "none" },
    "context":    { "type": "str",   "default": "" },
    "known_min":  { "type": "int",   "default": 5, "min": 1, "max": 100000 }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" }
  ],
  "catalog": {
    "summary": "Per-cluster expression violins for a marker gene (log1p).",
    "category": "single-cell",
    "tier": "verified",
    "status": "production",
    "input_formats": [".h5ad"],
    "chains_with": ["cluster", "deg"],
    "license": "MIT",
    "popularity": 79
  }
}
