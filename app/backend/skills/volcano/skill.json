{
  "id": "volcano",
  "version": "0.1.0",
  "title": "Volcano plot",
  "engine": "python",
  "omics": "bulk-rna-seq|proteomics",
  "entrypoint": "skills.volcano.run:run",
  "inputs": [{ "name": "matrix", "kind": "csv", "required": true }],
  "param_spec": {
    "fc_threshold":  { "type": "float", "default": 1.0,  "min": 0.0, "max": 5.0 },
    "fdr_threshold": { "type": "float", "default": 0.05, "min": 0.0, "max": 1.0 },
    "top_n":         { "type": "int",   "default": 10,   "min": 0,   "max": 50 },
    "highlight":     { "type": "str",   "default": "" }
  },
  "outputs": [
    { "name": "figure", "kind": "plotly_spec" }
  ],
  "catalog": {
    "summary": "DE volcano with FDR/log2FC thresholds and top-N gene labels.",
    "category": "data-visualization",
    "tier": "verified",
    "status": "production",
    "input_formats": [".csv"],
    "chains_with": ["enrichment"],
    "license": "MIT",
    "popularity": 88
  }
}
