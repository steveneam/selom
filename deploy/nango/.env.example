# Nango (self-hosted) — config template. Copy to `.env` and fill the secrets, then
# `sudo docker compose up -d`. The real `.env` is gitignored.

# Encryption key — base64 of 32 random bytes. Generate with:
#   openssl rand -base64 32
# Rotation is NOT supported: changing it after data exists breaks decryption.
NANGO_ENCRYPTION_KEY=

# Nango's own Postgres (isolated from Selom's application database).
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=change-me
NANGO_DB_NAME=nango
# Host port for the Nango DB (container is always 5432). 5433 avoids a host :5432.
NANGO_DB_PORT=5433

# Server + Connect-UI ports (bound to 127.0.0.1 by the compose file).
SERVER_PORT=3003
CONNECT_UI_PORT=3009

# Public origins the OAuth callback + Connect UI are derived from. Set them to whatever origin THIS
# container is actually reachable at — localhost while nothing is proxied to it, the public https
# origin once something is. Both failure directions are real:
#   - stale localhost while proxied: the provider sees the right redirect_uri (derived from the
#     forwarded host) and shows a perfect consent screen, then the code exchange re-derives the
#     callback from NANGO_SERVER_URL and is rejected — it breaks AFTER the human consents.
#   - claiming a public origin this container is NOT behind: every diagnostic lies. Cost a diagnosis
#     on 2026-07-25 (syd4 dev copy claimed to be the live syd2 broker).
# `bash preflight.sh [BASE]` checks the claim against evidence. Run it before any human consent.
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009

# Dashboard basic-auth.
FLAG_AUTH_ENABLED=true
NANGO_DASHBOARD_USERNAME=selom-admin
NANGO_DASHBOARD_PASSWORD=change-me

LOG_LEVEL=info
