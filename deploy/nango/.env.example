# Nango (self-hosted) — config template. Copy to `.env` and fill the secrets, then
# `sudo docker compose up -d`. The real `.env` is gitignored.

# Encryption key — base64 of 32 random bytes. Generate with:
#   openssl rand -base64 32
# Rotation is NOT supported: changing it after data exists breaks decryption.
NANGO_ENCRYPTION_KEY=

# Nango's own Postgres (isolated from Selom's application database).
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=change-me
NANGO_DB_NAME=nango
# Host port for the Nango DB (container is always 5432). 5433 avoids a host :5432.
NANGO_DB_PORT=5433

# Server + Connect-UI ports (bound to 127.0.0.1 by the compose file).
SERVER_PORT=3003
CONNECT_UI_PORT=3009

# Public origins the OAuth callback + Connect UI are derived from. localhost for a dev box;
# behind a reverse proxy set these to the public https origin.
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009

# Dashboard basic-auth.
FLAG_AUTH_ENABLED=true
NANGO_DASHBOARD_USERNAME=selom-admin
NANGO_DASHBOARD_PASSWORD=change-me

LOG_LEVEL=info
